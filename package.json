{
  "$schema": "https://raw.githubusercontent.com/qwqnt-community/types/main/plugin.schema.json",
  "name": "qwqnt-star-wand",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "pnpm run fmt && pnpm run lint && pnpm run typecheck && rolldown -c rolldown.config.ts",
    "build:only": "rolldown -c rolldown.config.ts",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@acidify/codec": "^0.1.0",
    "socket.io": "^4.8.3",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@qwqnt/types": "github:qwqnt-community/types",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "autoprefixer": "^10.4.23",
    "electron": "^45.3.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.6",
    "rolldown": "1.3.2",
    "rollup-plugin-postcss": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "electron"
    ]
  },
  "qwqnt": {
    "name": "qwqnt-star-wand",
    "inject": {
      "main": "./dist/main/index.js",
      "preload": "./dist/preload/index.js",
      "renderer": "./dist/renderer/index.js"
    },
    "dependencies": {
      "qwqnt-hako": "^1.0.1"
    }
  }
}
