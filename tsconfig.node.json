{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node", "electron", "@qwqnt/types/main"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/types/**/*",
    "src/*.ts",
    "./*.ts",
    "./package.json"
  ]
}
