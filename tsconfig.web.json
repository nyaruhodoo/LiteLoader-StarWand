{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@qwqnt/types/renderer"],
    "allowJs": true,
    "checkJs": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": [
    "src/renderer/**/*",
    "src/types/*.ts",
    "src/types/*.d.ts",
    "src/*.ts",
    "./package.json"
  ],
  "exclude": ["src/types/wrapper"]
}
